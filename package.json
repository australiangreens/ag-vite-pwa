{
  "name": "@australiangreens/ag-vite-pwa",
  "version": "0.1.0",
  "type": "module",
  "description": "Australian Greens defaults for making a Vite app an installable PWA",
  "license": "MIT",
  "author": "The Australian Greens <webops@greens.org.au>",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "tsc": "tsc --noEmit",
    "checkall": "pnpm tsc && pnpm test",
    "prepare": "husky",
    "prepublishOnly": "pnpm checkall && pnpm build",
    "precommit": "sh ./scripts/githooks/pre-commit.sh",
    "prepush": "sh ./scripts/githooks/pre-push.sh",
    "release": "node scripts/release.js",
    "ship": "pnpm publish --no-git-checks"
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "dependencies": {
    "vite-plugin-pwa": "^2.0.0",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "husky": "^9.1.7",
    "tsup": "^8.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.34.9",
  "homepage": "https://github.com/australiangreens/ag-vite-pwa#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/australiangreens/ag-vite-pwa.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
